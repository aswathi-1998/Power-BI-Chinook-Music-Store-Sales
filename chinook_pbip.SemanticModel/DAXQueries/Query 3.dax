DEFINE 
FUNCTION DISPLAYWITHSYMBOLUDF = (m :MEASUREREF) =>
	VAR _Current = m
	VAR _Previous = CALCULATE(m,SAMEPERIODLASTYEAR(DimDate[Date]))
	VAR _Symbol = 
	IF(ISFILTERED(DimDate[Year]),
		SWITCH(
			TRUE(),
			ISBLANK(_Previous),"",
			_Current>_Previous,UNICHAR(9650),
			_Current<_Previous,UNICHAR(9660),
			""
		),"")
	RETURN 
	"  "& _Symbol