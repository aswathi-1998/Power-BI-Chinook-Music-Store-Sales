table MeasureParameter
	lineageTag: dfc807a5-022a-4428-afd7-fe4e6a4fc500

	measure 'Selected Metric' =
			
			SWITCH
			    (
			        SELECTEDVALUE(MeasureParameter[MeasureParameter Order]),
			        0,[Quantity],
			        1,[Sales],
			        2,[Invoice Count],
			        [Sales]
			)
		lineageTag: 78e3990c-5ace-40e4-998a-ed7cc0be808f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MeasureParameter
		lineageTag: ebba630f-f6e1-4adf-b59e-8a5a712fba39
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'MeasureParameter Order'

		relatedColumnDetails
