				    ("Quantity", NAMEOF('MeasuresTable'[Quantity]), 0),
				    ("Sales",NAMEOF('MeasuresTable'[Sales]),1),
				    ("Invoice Count",NAMEOF('MeasuresTable'[Invoice Count]),2)
				}

	annotation PBI_Id = 6982b92d536d47d4bd579a0feea49d6a

