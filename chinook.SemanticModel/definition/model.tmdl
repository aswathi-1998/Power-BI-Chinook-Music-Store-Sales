model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup SourceFiles

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["chinook album","chinook artist","chinook customer","chinook employee","chinook genre","chinook invoice","chinook invoiceline","chinook mediatype","chinook playlist","BridgePlaylisttrack","chinook track","FactSales","DimTrack","DimCustomer","DimPlaylist","chinook playlisttrack","MeasuresTable"]

annotation PBI_ProTooling = ["TMDLView_Desktop","CalcGroup","DaxQueryView_Desktop","DevMode"]

ref table BridgePlaylisttrack
ref table FactSales
ref table DimTrack
ref table DimCustomer
ref table DimPlaylist
ref table DimDate
ref table MeasuresTable
ref table TopCategory
ref table MeasureParameter
ref table 'Calculation group'
ref table 'PVM Steps'

ref cultureInfo en-US

