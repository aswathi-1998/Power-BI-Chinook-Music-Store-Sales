table TopCategory
	lineageTag: 8d0a6ffd-1f51-48e3-8808-a75e9b89e3c5

	measure TopNSales = ```
			
			VAR _sel = SELECTEDVALUE(TopCategory[TopCategory Order])
			VAR _rank_desc = 
			        SWITCH(
			            _sel,
			            0,RANKX(ALL(DimTrack[Album Label]),[Selected Metric],,DESC,Skip),
			            1,RANKX(ALL(DimTrack[Artist Name]),[Selected Metric],,DESC,Skip),
			            2,RANKX(ALL(DimTrack[Track Label]),[Selected Metric],,DESC,Skip),
			            BLANK())
			RETURN
			IF(_rank_desc<=5,[Selected Metric])
			```
		lineageTag: 6414610d-edc9-429c-9475-bcb0cde26627

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Analysis Title' = ```
			
			VAR _Category = 
			    SWITCH(
			        SELECTEDVALUE(TopCategory[TopCategory Order]),
			        0,"Album Titles ",
			        1,"Artists ",
			        2,"Track Names"
			    )
			
			RETURN
			"Top Performing " & _Category 
			```
		lineageTag: de1694ab-f2e6-4de2-b32d-b73e8a6899fe

	measure 'Top Analysis Subtitle' = ```
			
			VAR _Metric =
			    SWITCH(
			        SELECTEDVALUE(MeasureParameter[MeasureParameter Order]),
			        0,"Quantity Sold ",
			        1,"Sales ",
			        2,"Number of Invoices"
			    )
			
			RETURN 
			"By " & _Metric 
			```
		lineageTag: 9d898a4c-efae-4ca9-907a-92188155ee83

