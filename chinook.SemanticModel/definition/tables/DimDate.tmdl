table DimDate
	lineageTag: 095f9ca5-17bc-4809-b777-abe6f2e611b9
	dataCategory: Time

	column Date
		isKey
		formatString: Long Date
		lineageTag: 406a42a4-6cd5-489f-81bb-59450da1e6a8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		formatString: 0
		lineageTag: 5e1c8686-cd6b-41a5-84ce-81aa0020668f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: f44e2bab-b379-42b6-bcc1-6568a3bf8005
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column MonthNo
		formatString: 0
		lineageTag: 074a0aff-6d74-427c-ac3d-11accdd54b01
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: 01db1010-ed11-44ca-882c-2a22419f35cf
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

